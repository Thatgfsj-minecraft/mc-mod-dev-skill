{
  "name": "mc-debug-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing a running Minecraft client via the MCB v1 debug bridge protocol (world state, live logs, commands, screenshot). Loader-agnostic reference consumer.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mc-debug-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "npm run build && node smoke.mjs",
    "integration": "npm run build && node integration.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^22.5.0"
  }
}
